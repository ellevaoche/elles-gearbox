{
  "branches": ["main"],
  "repositoryUrl": "https://github.com/ellevaoche/elles-gearbox.git",
  "tagFormat": "v${version}",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm run package -- --out elles-gearbox.vsix"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "elles-gearbox.vsix",
            "name": "elles-gearbox-${nextRelease.version}.vsix",
            "label": "Elle's Gearbox ${nextRelease.version} (VSIX)"
          }
        ],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
